TELEGRAM_TOKEN=
# AI provider for chat tasks (formatter, summary, roast, profile): openai or anthropic
AI_PROVIDER=openai
# Required in every mode: audio transcription (Whisper) is OpenAI-only
OPENAI_API_KEY=
# Required only when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional model overrides — OpenAI (used when AI_PROVIDER=openai)
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_FORMATTER_MODEL=gpt-6-astra
OPENAI_SUMMARY_MODEL=gpt-6-astra
# Model that distills the compact author profile after every diary message, defaults to OPENAI_SUMMARY_MODEL
OPENAI_PROFILE_MODEL=gpt-6-astra
# High-reasoning model behind the 🔥 Roast (разъёб) button
OPENAI_ROAST_MODEL=gpt-6-astra
# Optional model overrides — Anthropic (used when AI_PROVIDER=anthropic)
ANTHROPIC_FORMATTER_MODEL=claude-opus-5
ANTHROPIC_SUMMARY_MODEL=claude-opus-5
# Defaults to ANTHROPIC_SUMMARY_MODEL
ANTHROPIC_PROFILE_MODEL=claude-opus-5
ANTHROPIC_ROAST_MODEL=claude-opus-5
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Your Telegram user_id (find it via @userinfobot)
ALLOWED_USER_ID=
# Your timezone, e.g. Europe/Moscow
TIMEZONE=Europe/Moscow
# Hour the diary day starts (0-23), e.g. 4
DIARY_DAY_START_HOUR=0
# Send messages silently, without push notifications (true/false)
SILENT_NOTIFICATIONS=true
# Language the roast (разъёб) replies in, e.g. Russian, English
ROAST_LANGUAGE=Russian
# Optional: override the built-in roast (разъёб) system prompt
ROAST_SYSTEM_PROMPT=
